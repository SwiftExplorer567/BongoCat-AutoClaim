<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BongoCatAutoClaim.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="Bongo Cat AutoClaim">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Height="44" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/logo.png" Width="18" Height="18" />
                <TextBlock Text="Bongo Cat AutoClaim" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,4,24,20" Spacing="12">

                <!-- Status -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StatusBadge" Width="52" Height="52" CornerRadius="26" VerticalAlignment="Top">
                                <FontIcon x:Name="StatusIcon" FontSize="24" Glyph="&#xE895;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="StatusBody" Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse x:Name="GameDot" Width="8" Height="8" VerticalAlignment="Center" />
                                <TextBlock x:Name="GameText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="·" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="BackupText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="GameButton" Grid.Column="1" Click="OnGameButtonClick" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Chest timers -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Padding="16,20">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <Grid Width="104" Height="104" HorizontalAlignment="Center">
                                <ProgressRing x:Name="CosmeticRing" Width="104" Height="104" IsIndeterminate="False" Maximum="1800"
                                              Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                                <TextBlock x:Name="CosmeticTime" Text="--:--" FontSize="22" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Spacing="0">
                                <TextBlock x:Name="CosmeticTitle" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="CosmeticCaption" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16,20">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <Grid Width="104" Height="104" HorizontalAlignment="Center">
                                <ProgressRing x:Name="EmoteRing" Width="104" Height="104" IsIndeterminate="False" Maximum="1800"
                                              Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                                <TextBlock x:Name="EmoteTime" Text="--:--" FontSize="22" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Spacing="0">
                                <TextBlock x:Name="EmoteTitle" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmoteCaption" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Settings -->
                <TextBlock x:Name="SettingsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,8,0,0" />

                <StackPanel Spacing="4">
                    <toolkit:SettingsCard x:Name="AutoPatchCard">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE895;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="AutoPatchToggle" OnContent="" OffContent="" MinWidth="0" Toggled="OnAutoPatchToggled" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Name="StartupCard">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="StartupToggle" OnContent="" OffContent="" MinWidth="0" Toggled="OnStartupToggled" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Name="FolderCard">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Button x:Name="BrowseButton" Click="OnBrowseClick" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Name="LanguageCard">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF2B7;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="LanguageBox" MinWidth="140" SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem Content="Türkçe" Tag="tr" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </toolkit:SettingsCard>
                </StackPanel>

                <!-- Actions -->
                <Grid ColumnSpacing="8" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PatchButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                            Padding="12,8" Click="OnPatchClick" />
                    <Button x:Name="RestoreButton" Grid.Column="1" Padding="16,8" Click="OnRestoreClick" />
                </Grid>

                <!-- Footer -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ActivityText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <HyperlinkButton Content="GitHub" Padding="6,2" FontSize="12"
                                         NavigateUri="https://github.com/SwiftExplorer567/BongoCat-AutoClaim" />
                        <HyperlinkButton x:Name="QuitLink" Padding="6,2" FontSize="12" Click="OnQuitClick" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
